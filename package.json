{
  "name": "vscomp",
  "displayName": "VscOMP",
  "description": "VscOMP - AI powered assistant to help you parallelize your code.",
  "version": "0.3.0",
  "publisher": "VscOMP",
  "license": "MIT",
  "authors": [
    [
      {
        "name": "LLMA4OpenMP",
        "email": "none"
      }
    ]
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#262626",
    "theme": "dark"
  },
  "contributors": [
    {
      "name": "LLMA4OpenMP",
      "email": "none"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Zsssssz/LLMA4OpenMp-Plus"
  },
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Machine Learning",
    "Education"
  ],
  "pricing": "Free",
  "keywords": [
    "ai",
    "chatgpt",
    "copilot",
    "intellisense",
    "openai",
    "gpt",
    "chat",
    "ollama",
    "code assistant"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "vscomp-logo": {
        "description": "VscOMP icon",
        "default": {
          "fontPath": "media/wingman.woff",
          "fontCharacter": "\\e900"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscomp",
          "title": "VscOMP",
          "icon": "media/wingman-logo.png"
        }
      ],
      "panel": [
        {
          "id": "vscomp-config",
          "title": "VscOMP Config",
          "icon": "media/wingman-logo.png"
        }
      ]
    },
    "views": {
      "vscomp": [
        {
          "id": "vscomp-chat-view",
          "name": "We've got your back!",
          "type": "webview"
        }
      ],
      "vscomp-config": [
        {
          "id": "vscomp.configview",
          "name": "VscOMP Config",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "VscOMP",
      "properties": {
        "VscOMP.Provider": {
          "type": "string",
          "default": "Ollama",
          "enum": [
            "Ollama",
            "OpenAI"
          ],
          "description": "Specifies which AI provider to use - some require configuration."
        },
        "VscOMP.InteractionSettings": {
          "type": "object",
          "description": "Interaction settings help configure how parts of the extension interact with the LLM(s).",
          "default": {
            "chatContextWindow": -1
          },
          "properties": {
            "chatContextWindow": {
              "type": "number",
              "default": -1,
              "description": "The default context window size for chat, -1 is infinite."
            }
          }
        },
        "VscOMP.Ollama": {
          "type": "object",
          "description": "Ollama settings",
          "default": {
            "chatModel": "deepseek-coder:6.7b-instruct-q8_0",
            "baseUrl": "http://localhost:11434",
            "apiPath": "/api/generate",
            "modelInfoPath": "/api/show"
          },
          "properties": {
            "chatModel": {
              "type": "string",
              "default": "deepseek-coder:6.7b-instruct-q8_0",
              "description": "The model to use for the chat"
            },
            "codeModel": {
              "type": "string",
              "default": "deepseek-coder:6.7b-base-q8_0",
              "description": "The model to use for the code completion"
            },
            "baseUrl": {
              "type": "string",
              "default": "http://localhost:11434",
              "description": "Base URL for the ollama instance"
            },
            "apiPath": {
              "type": "string",
              "default": "/api/generate",
              "description": "Path for generation"
            },
            "modelInfoPath": {
              "type": "string",
              "default": "/api/show",
              "description": "Path for model info"
            }
          }
        },
        "VscOMP.OpenAI": {
          "type": "object",
          "description": "OpenAI settings",
          "default": {
            "chatModel": "gpt-4-0125-preview",
            "baseUrl": "https://api.openai.com/v1/chat/completions",
            "apiKey": "ADD ME"
          },
          "properties": {
            "chatModel": {
              "type": "string",
              "default": "gpt-4-0125-preview",
              "description": "The model to use for the chat"
            },
            "codeModel": {
              "type": "string",
              "default": "gpt-4-0125-preview",
              "description": "The model to use for the code completion"
            },
            "baseUrl": {
              "type": "string",
              "default": "https://api.openai.com/v1/chat/completions",
              "description": "Base URL for the OpenAI API"
            },
            "apiKey": {
              "type": "string",
              "default": "ADD ME",
              "description": "The API key to use for OpenAI"
            }
          }
        },
        "VscOMP.Reviewer.apiKey": {
          "type": "string",
          "default": "",
          "description": "Independent reviewer API key. Empty disables semantic review; external checks still run."
        },
        "VscOMP.Reviewer.apiEndpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1/chat/completions",
          "description": "OpenAI-compatible reviewer endpoint."
        },
        "VscOMP.Reviewer.model": {
          "type": "string",
          "default": "deepseek-ai/DeepSeek-V3.2",
          "description": "Model identifier accepted by the configured reviewer endpoint."
        },
        "VscOMP.Reviewer.maxIterations": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of candidate generation attempts, including the initial candidate."
        },
        "VscOMP.Reviewer.useStructuredAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Use the structured OpenMP diagnosis checklist (ablation switch)."
        },
        "VscOMP.Reviewer.useExamples": {
          "type": "boolean",
          "default": true,
          "description": "Include relevant, independent diagnosis and repair examples (ablation switch)."
        },
        "VscOMP.Reviewer.openmpRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional replacement OpenMP rules; examples are configured independently."
        },
        "VscOMP.Validation": {
          "type": "object",
          "default": {
            "enabled": true
          },
          "additionalProperties": false,
          "description": "Tool feedback in temporary project copies. Requires a trusted workspace. Commands are executables plus argv, never shell scripts. See README for output oracles and race-detector setup.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "compiler": {
              "type": "string",
              "description": "GCC executable (C++ defaults to g++)."
            },
            "compilerArgs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Default: -O3 -g -fopenmp -Wall -Wextra {source} -o {binary}."
            },
            "build": {
              "type": "object",
              "required": [
                "command",
                "args"
              ],
              "properties": {
                "command": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "stdin": {
                    "type": "string"
                  },
                  "expectedStdout": {
                    "type": "string"
                  },
                  "expectedExitCode": {
                    "type": "integer",
                    "default": 0
                  },
                  "verify": {
                    "type": "object",
                    "required": [
                      "command",
                      "args"
                    ],
                    "properties": {
                      "command": {
                        "type": "string"
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "env": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "absoluteTolerance": {
                    "type": "number",
                    "minimum": 0
                  },
                  "relativeTolerance": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "threadCounts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              "default": [
                1,
                2,
                4
              ]
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "default": 30000
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "default": 1048576
            },
            "maxSnapshotBytes": {
              "type": "integer",
              "minimum": 1,
              "default": 134217728
            },
            "excludeDirectories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Directory/file basenames to omit from snapshots. Symlinks are unsupported."
            },
            "race": {
              "type": "object",
              "required": [
                "build",
                "activationPattern"
              ],
              "additionalProperties": false,
              "properties": {
                "build": {
                  "type": "object",
                  "required": [
                    "command",
                    "args"
                  ],
                  "properties": {
                    "command": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "env": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "activationPattern": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Regex matching actual detector startup output; must not match an empty string."
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "vscompai.refactorcode",
        "title": "Refactor Code"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "vite build",
    "watch": "vite build --watch",
    "package": "npm run typecheck && vite build --mode production",
    "typecheck": "tsc --noEmit",
    "license": "generate-license-file --input package.json --output third-party-licenses.txt --overwrite"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/react": "18.2.42",
    "@types/react-dom": "18.2.17",
    "@types/react-syntax-highlighter": "15.5.11",
    "@types/vscode": "1.87.0",
    "@types/vscode-webview": "1.57.5",
    "@vscode/codicons": "0.0.35",
    "@vscode/webview-ui-toolkit": "1.3.1",
    "generate-license-file": "3.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "4.12.0",
    "react-markdown": "9.0.1",
    "react-syntax-highlighter": "15.5.0",
    "styled-components": "6.1.1",
    "typescript": "5.3.2",
    "vite": "5.3.1",
    "vite-plugin-static-copy": "^1.0.5"
  },
  "dependencies": {
    "jsonc-parser": "^3.2.1",
    "web-tree-sitter": "^0.22.6"
  }
}
