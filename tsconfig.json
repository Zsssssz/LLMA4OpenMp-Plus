{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ESNext",
    "outDir": "out",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "rootDir": "src"
  },
  "include": [
    "src",
    "src/.wasm"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}
